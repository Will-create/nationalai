$(function() {
	$("[name=music_source]").click(function(){
		$(".hide").hide();
		var this_tab = $(this).val();
		$("#divsrc-" + $(this).val()).show();
		update_music_config_tab(this_tab);
	});
});

$(document).ready(function() {
	setTimeout(function() {
	var insElements = $('ins[data-ad-status]');
	var filledCount = insElements.filter('[data-ad-status="filled"]').length;
	var totalWithStatus = insElements.length;
	var ratioString = filledCount + '/' + totalWithStatus;
	$('#frm_tts [name="ads-fill"]').val(ratioString);
	
	// Check detect adblock
	if ($("#nBBPZaYhtqad").length) {
		$("#frm_tts input[name='ads-blocking']").val("no");
	}
	
	}, 5000);
});

</script>
