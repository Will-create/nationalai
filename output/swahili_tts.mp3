.scrollbar_list_voice {
	max-height: 300px;
	overflow-y: scroll;
}
.scrollbar_list_voice::-webkit-scrollbar-track {
	-webkit-box-shadow: inset 0 0 6px #d2e3f3;
	background-color: #F5F5F5;
}

.scrollbar_list_voice::-webkit-scrollbar {
	width: 6px;
	background-color: #F5F5F5;
}

.scrollbar_list_voice::-webkit-scrollbar-thumb {
	background-color: #555555;
}
.item_voice{
	background: #f6fbff;
	border-top: solid 1px #d2e3f3;
    margin-top: 0px !important;
    margin-bottom: 0px !important;
	font-weight: bold;
}
.item_voice:hover{
	background: #c8e2ff;
}
.img-circle {
    border-radius: 50%;
}
[class*="icheck-"] > input:first-child:checked + label > img {
    border: 3px solid var(--white);
}
[class*=icheck-]>input[type=radio]:first-child+label::before {
    top: 10px;
}
[class*=icheck-]>input:first-child:checked+input[type=hidden]+label::after, [class*=icheck-]>input:first-child:checked+label::after {
    top: 10px !important;
}

.vjs-control-bar{
    visibility: visible !important;
    opacity: 1 !important;
}
.grecaptcha-badge { 
    visibility: hidden;
}

#select_lang {
  width: 100%;
  height: 32px;
}
.placeholder_listvoice {
  height: 245px;
  width: 100%;
}
.box_audjust {
  min-height: 220px;
}
.irs--modern .irs-handle > i:nth-child(1) {
  width: 8px;
  height: 8px;
}

.voice_available_disabled {
  opacity: 0.75;
}
.voice_available_disabled:hover {
  background: #ccc !important;
}
.item_voice {
  background: #f6fbff;
  font-weight: bold;
  cursor: pointer;
}
.item_voice:hover {
  background: #c8e2ff;
}
.item_voice .ai_name {
  font-size: 10px;
}
.item_voice .premium_label {
  font-size: 9px;
}
.item_voice_selected {
  background: #b0d6ff;
}
.item_voice_selected .img-circle{
	border: 3px solid var(--white);
}
.img-circle {
  border-radius: 50%;
}
.translate-middle-x {
    transform: translateX(-50%) !important;
}
.start-50 {
    left: 50% !important;
}
.bottom-0 {
    bottom: -10px !important;
}
.ai_name_bin{
	background: #a26fff;
}
.ai_name_goo{
	background: #58a0ed;
}
