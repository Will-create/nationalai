	<script>
	$(document).ready(function(){
		$('body').tooltip({selector: '[data-toggle="tooltip"]'});
		$(".text_input").maxLength({
			maxChars: 500,
			// clearChars: false,
			// countHolder: '.chars-count2',
			// remainHolder: '.chars-remaining2',
			// maxHolder: '.chars-max2',
			onLimitOver: function(){ $('.text_input').css('color', 'red'); $('.chars-remaining2-container').css('color', 'red'); },
			onLimitUnder: function(){ $('.text_input').css('color', '#000'); $('.chars-remaining2-container').css('color', '#000'); }
		});
		
		
		// Load reCaptcha event click focus body
		$(document).click(function(e) {
			// alert('clicked');
			// checkLoad();
		});
		
		function checkLoad() {
			if(!window.grecaptcha){   
				// alert("Not loaded");
				// load captcha if not exist
				var head = document.getElementsByTagName('head')[0];
				var script = document.createElement('script');
				script.type = 'text/javascript';
				script.src = 'https://www.google.com/recaptcha/api.js?render=6Ldd91QfAAAAACSeHSLqVNGaphuA7cXfc3YCfNoR';
				head.appendChild(script);
			}else{    
				// alert("Loaded");
				console.log("Loaded recaptcha");
			}
		}

	});
	// Play only one audio
	$('audio').on('play', function(e) {
	  $('audio').not(this)
		.each(function(index, audio) {
		audio.pause();
	  });
	});
	
	//menu
	var url = String(window.location);
	url = url.split("?");
	url = url[0];
	url = url.replace("#", "");
	url = url.replace(/\/$/, "");
	// Will only work if string in href matches with location
	var nodeParent = $('#web-language-selector li a[href="' + url + '"]').parents();
	// alert('ok '+nodeParent);
	// console.log("logs url: " + url);
	// console.log("logs " + nodeParent[2]);
	if (nodeParent[2]) {
		if (nodeParent[2].nodeName.toLowerCase() !== 'li') {
			$('#web-language-selector li a[href="' + url + '"]').parent().addClass('active');
		} else {
			$('#web-language-selector li a[href="' + url + '"]').closest('li.menu-item-has-children').addClass('active');
		}
	}
	
	// Refresh captcha
	$(document).on('click', 'a.refresh_captcha', function() {
		$("#captcha_image").attr("src", "https://ttsfree.com/voice/captcha.php?sign=?" + new Date().getTime());
		$("#captcha_input").val("");
	});
	
	$(document).on('click', 'a.confirm_captcha', function() {
		var captcha_input = $("#captcha_input").val();
		if (captcha_input === '') {
			alert('Please enter code');
			$("#captcha_input").focus();
		} else {
			// alert("clidk "+captcha_input);
			var datastring = $("#frm_tts").serialize() + "&sc_width=" + width_current + "&sc_height=" + height_current + "&action_mod=verify";
			$('.label_process').html('<i class="fas fa-cog fa-spin"></i> Verifying...');
			$.ajax({
				type: "POST",
				url: SITE_ROOT + "/ajax/verify_captcha.php",
				data: datastring,
				dataType:"json",
				success: function (response) {
					if(response.status === "success") {
						$('.label_process').html(response.mess);
					} else if(response.status === "error") {
						$('.label_process').html(response.mess);
					}
					// alert('done');
				},
				error: function (jqXHR, exception) {
					var msg = '';
					if (jqXHR.status === 0) {
						msg = 'Not connect.\n Verify Network.';
					} else if (jqXHR.status == 404) {
						msg = 'Requested page not found. [404]';
					} else if (jqXHR.status == 500) {
						msg = 'Internal Server Error [500].';
					} else if (exception === 'parsererror') {
						msg = 'Requested JSON parse failed.';
					} else if (exception === 'timeout') {
						msg = 'Time out error.';
					} else if (exception === 'abort') {
						msg = 'Ajax request aborted.';
					} else {
						msg = 'Uncaught Error.\n' + jqXHR.responseText;
					}
					
				}
			});
		}	// END else
			
	});
	
	</script>
