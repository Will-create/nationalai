										<div class="d-flex align-items-center">
											Turn On/Off background music 
											<button type="button" class="btn btn-sm btn-toggle on_off_musicbackground" data-toggle="button" aria-pressed="" autocomplete="off" >
												<div class="handle"></div>
											</button>
											<input type="hidden" name="music" value="">
										</div>
										<hr>
										
										<div class="form-check icheck-info">
											<label><input class="form-check-input" type="radio" name="music_source" value="lib" checked /> From Library</label>
											<label><input class="form-check-input" type="radio" name="music_source" value="src" /> From Youtube/Soundcloud</label>
											
											<div id="divsrc-lib" class="hide">
												<button class="btnv btn-secondary p-1 rounded w-100 my-1 open_library" type="button" id="inputGroupFileAddon04">Browse</button> or <a class="toggle_input_track" href="#">Enter Track's ID</a>
												<div class="input-group or_enter_track" style="display: none;">
													<input type="text" id="track_id" name="track_id" class="form-control" placeholder="Enter Track's ID" aria-label="Enter Track ID" aria-describedby="basic-addon1" maxlength="10">
													<div class="input-group-append">
														<button class="btnv btn-secondary p-1 rounded preview_track" type="button"><i class="fas fa-play"></i> Preview</button>
													</div>
												</div>
												<div class="box_track_process mt-1">
												</div>
												<p>We connect with FreeMusicBG - A collection of free music for commercial or free use, with an attribution license to the author.
												<br>You can view more and find the Track's ID here: <a target="_blank" href="https://freemusicbg.com" title="Free Background Music">https://freemusicbg.com</a></p>
											</div>
											<div id="divsrc-src" class="hide" style="display:none">
												<div class="input-group mb-3">
													<div class="input-group-prepend"> <span class="input-group-text" id="basic-addon1">URL</span> </div>
													<input type="text" name="music_url" class="form-control" placeholder="Enter Youtube or Soundcloud URL" aria-label="Enter Youtube or Soundcloud" aria-describedby="basic-addon1" maxlength="500" autocomplete="on">
													<div class="input-group-append">
														<button class="btnv btn-secondary p-1 rounded play_music_url" type="button"><i class="fas fa-play"></i> Play</button>
													</div>
												</div>
												Enter the URL, then click the "Play" button to continue the process.
												<div class="ajax_process">
												</div>
