												<input type="hidden" name="bgm_loop" placeholder="Loop">
												<input type="hidden" name="bgm_volume" placeholder="Volume">
												<input type="hidden" name="ads-fill">
												<input type="hidden" name="ads-blocking">
											</div>
											
