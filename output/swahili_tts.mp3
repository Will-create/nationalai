													<ul>
														<li>https://www.youtube.com/watch?v=VIDEO_ID</li>
														<li>https://www.youtube.com/watch?v=VIDEO_ID&feature=youtu.be</li>
														<li>https://youtu.be/VIDEO_ID</li>
														<li>https://www.youtube.com/embed/VIDEO_ID</li>
														<li>https://www.youtube.com/watch?v=VIDEO_ID&list=PLAYLIST_ID</li>
														<li>https://www.youtube-nocookie.com/embed/VIDEO_ID</li>
														<li>https://soundcloud.com/username/trackname</li>
														<li>https://soundcloud.com/keysofmoon/infinitely-ambient-music-free-download</li>
													</ul>
													</small>
												</div>
											</div>
											
